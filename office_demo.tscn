[sub_resource type="Shader" id="Shader_asxei"]
code = "shader_type spatial; render_mode ambient_light_disabled, specular_disabled; uniform float grid_strength=0.5; uniform vec4 base:source_color=vec4(0.42,0.55,0.57,1.0); varying vec3 wp; void vertex(){wp=(MODEL_MATRIX*vec4(VERTEX,1.0)).xyz;} void fragment(){vec2 g=abs(fract(wp.xz/2.0-0.5)-0.5)/max(fwidth(wp.xz/2.0),vec2(0.0001)); float line=1.0-min(min(g.x,g.y),1.0); ALBEDO=mix(base.rgb,base.rgb*0.85,line*grid_strength); ROUGHNESS=1.0;} void light(){DIFFUSE_LIGHT += ALBEDO * (vec3(0.6)+0.4*ATTENUATION);}"

